ng","block":"Fora do ritmo habitual","block_toggle":true,"resource":"Iter_Marketing::rules","label":"Fora do ritmo habitual","hint":"Quem já tem algumas compras e passou do próprio intervalo médio entre elas. Ex.: 3 compras em 60 dias = a cada 30 dias; com 20% de tolerância, o e-mail vai no 36º dia.","type":"boolean","default":0,"scope":"website"},{"path":"marketing/overdue/mode","group":"Marketing","block":"Fora do ritmo habitual","resource":"Iter_Marketing::rules","label":"Envio","hint":"Aguardar aprovação: a sugestão fica em Marketing → Sugestões até alguém enviar ou descartar.","type":"select","default":"review","options":{"review":"Aguardar aprovação","auto":"Automático"},"scope":"website"},{"path":"marketing/overdue/min_orders","group":"Marketing","block":"Fora do ritmo habitual","resource":"Iter_Marketing::rules","label":"Só com pelo menos","unit":"pedidos pagos","type":"number","default":3,"min":2,"max":100,"scope":"website"},{"path":"marketing/overdue/tolerance","group":"Marketing","block":"Fora do ritmo habitual","resource":"Iter_Marketing::rules","label":"Tolerância além do intervalo médio","unit":"%","type":"number","default":20,"min":0,"max":500,"scope":"website"},{"path":"marketing/never_bought/active","group":"Marketing","block":"Cadastrou e nunca comprou","block_toggle":true,"resource":"Iter_Marketing::rules","label":"Cadastrou e nunca comprou","hint":"Clientes com consentimento, cadastrados há D dias, sem nenhum pedido pago. Uma vez por cliente.","type":"boolean","default":0,"scope":"website"},{"path":"marketing/never_bought/mode","group":"Marketing","block":"Cadastrou e nunca comprou","resource":"Iter_Marketing::rules","label":"Envio","hint":"Aguardar aprovação: a sugestão fica em Marketing → Sugestões até alguém enviar ou descartar.","type":"select","default":"review","options":{"review":"Aguardar aprovação","auto":"Automático"},"scope":"website"},{"path":"marketing/never_bought/days","group":"Marketing","block":"Cadastrou e nunca comprou","resour